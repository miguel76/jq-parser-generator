{
  "name": "csv",
  "rules": {
    "record": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_field"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": ","
              },
              {
                "type": "SYMBOL",
                "name": "_field"
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "PATTERN",
              "value": "\r?\n"
            },
            {
              "type": "EOF"
            }
          ]
        }
      ]
    },
    "_field": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "quoted"
        },
        {
          "type": "SYMBOL",
          "name": "field"
        }
      ]
    },
    "quoted": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "\""
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "text"
              },
              {
                "type": "SYMBOL",
                "name": "escaped_quote"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": "\""
        }
      ]
    },
    "text": {
      "type": "PATTERN",
      "value": "[^\"]+"
    },
    "escaped_quote": {
      "type": "STRING",
      "value": "\"\""
    },
    "field": {
      "type": "PATTERN",
      "value": "[^,\"\r\n]*"
    }
  },
  "extras": []
}
