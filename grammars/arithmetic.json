{
  "name": "arithmetic",
  "rules": {
    "expression": {
      "type": "SYMBOL",
      "name": "_sum"
    },
    "_sum": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "sum"
        },
        {
          "type": "SYMBOL",
          "name": "_product"
        }
      ]
    },
    "sum": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_product"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "FIELD",
                "name": "operator",
                "content": {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "STRING",
                      "value": "+"
                    },
                    {
                      "type": "STRING",
                      "value": "-"
                    }
                  ]
                }
              },
              {
                "type": "SYMBOL",
                "name": "_product"
              }
            ]
          }
        }
      ]
    },
    "_product": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "product"
        },
        {
          "type": "SYMBOL",
          "name": "_factor"
        }
      ]
    },
    "product": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_factor"
        },
        {
          "type": "REPEAT1",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "FIELD",
                "name": "operator",
                "content": {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "STRING",
                      "value": "*"
                    },
                    {
                      "type": "STRING",
                      "value": "/"
                    },
                    {
                      "type": "STRING",
                      "value": "%"
                    }
                  ]
                }
              },
              {
                "type": "SYMBOL",
                "name": "_factor"
              }
            ]
          }
        }
      ]
    },
    "_factor": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "number"
        },
        {
          "type": "SYMBOL",
          "name": "negation"
        },
        {
          "type": "SYMBOL",
          "name": "_group"
        }
      ]
    },
    "negation": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "SYMBOL",
          "name": "_factor"
        }
      ]
    },
    "_group": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "_sum"
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "number": {
      "type": "PATTERN",
      "value": "[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?"
    }
  }
}
